# --- Gemini API keys ---------------------------------------------------------
# Without any key the app falls back to a deterministic mock planner so the
# demo still works end-to-end.
#
# Either set ONE key:
GEMINI_API_KEY=
#
# Or POOL of keys (recommended for the free tier — 5 RPM per key, so 3 keys
# ≈ 15 RPM, with automatic round-robin and cooldown on 429).
# GEMINI_API_KEYS=key_aaa,key_bbb,key_ccc
#
# Or numbered (alternative pool form):
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...

# Optional override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
